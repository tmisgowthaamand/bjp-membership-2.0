# ── BJP Local Body Application backend ─────────────────────────────
# Copy to .env and fill in real values.
NODE_ENV=development
PORT=5000

# Frontend origin(s) allowed for CORS. Comma-separate multiple origins.
# Local dev: http://localhost:3000
# Production (Render): set to your Vercel URL, e.g. https://bjp-mebership.vercel.app
CLIENT_ORIGIN=https://bjp-mebership.vercel.app,http://localhost:3000

# ── DB1: Voter Roll — READ-ONLY ───────────────────────────────────
MONGO_VOTER_URL=
MONGO_VOTER_DB_NAME=voter_db

# ── DB2: Applications store — read/write ──────────────────────────
MONGO_APP_URL=
MONGO_APP_DB_NAME=bjp_localbody

# ── 2Factor SMS OTP ───────────────────────────────────────────────
SMS_API_KEY=
SMS_TEMPLATE_NAME=OTP1

# ── Admin panel login ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ── Backblaze B2 (S3-compatible) media storage ────────────────────
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=
B2_PUBLIC_BASE=

# ── Cloudinary Media Storage ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Resend Email Service & Admin Email OTP Authentication ─────────
RESEND_FROM_EMAIL=BJP Admin Portal <onboarding@resend.dev>

# ── Admin Role Credentials & Individual Resend API Keys ───────────
SUPER_ADMIN_EMAIL=admin1@example.com
SUPER_ADMIN_RESEND_API_KEY=re_example_key_1

STATE_ADMIN_EMAIL=admin2@example.com
STATE_ADMIN_RESEND_API_KEY=re_example_key_2

DISTRICT_ADMIN_EMAIL=admin3@example.com
DISTRICT_ADMIN_RESEND_API_KEY=re_example_key_3
